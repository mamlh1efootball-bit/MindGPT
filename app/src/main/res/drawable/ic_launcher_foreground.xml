<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cosmic Orbit Back Arc -->
    <path
        android:pathData="M18,66 C23,38 85,26 95,44"
        android:strokeWidth="2.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="18"
                android:startY="66"
                android:endX="95"
                android:endY="44"
                android:type="linear">
                <item android:color="#60A5FA" android:offset="0.0" />
                <item android:color="#93C5FD" android:offset="0.5" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central High-Tech 'M' Icon Body -->
    <path
        android:pathData="M30,78 L30,34 L42,34 L54,54 L66,34 L78,34 L78,78 L68,78 L68,50 L57,67 L51,67 L40,50 L40,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="34"
                android:endX="78"
                android:endY="78"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#E0E7FF" android:offset="0.5" />
                <item android:color="#93C5FD" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cosmic Orbit Front Arc -->
    <path
        android:pathData="M95,44 C98,56 68,84 18,66"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="95"
                android:startY="44"
                android:endX="18"
                android:endY="66"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#60A5FA" android:offset="0.4" />
                <item android:color="#818CF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Orbit Star -->
    <path
        android:pathData="M88,46 L90,42 L94,40 L90,38 L88,34 L86,38 L82,40 L86,42 Z"
        android:fillColor="#FFFFFF" />
</vector>
